# FloorIA Environment Configuration
# IMPORTANT: Never commit your actual API keys to git!
# Copy this file to .env and replace with your actual values

# Roboflow API Configuration
# Get these values from your Roboflow account dashboard
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=cubicasa5k-2-qpmsa-tppfc
ROBOFLOW_PROJECT=cubicasa5k-2-qpmsa-tppfc
ROBOFLOW_VERSION=1

# Supabase Configuration
# Get these values from your Supabase project dashboard
# SUPABASE_URL: Your project URL (e.g., https://your-project.supabase.co)
# SUPABASE_TOKEN: Your project's anon/public key
# SUPABASE_APIKEY: Your project's anon key (same as SUPABASE_TOKEN, kept for compatibility)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_TOKEN=your_supabase_anon_key_here
SUPABASE_APIKEY=your_supabase_anon_key_here

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit the .env file to version control
# 4. For Supabase setup, see AUTHENTICATION.md documentation

# Security Note:
# The .env file is automatically excluded from git via .gitignore
# Always keep your API keys and tokens secure and private
